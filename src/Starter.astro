---
import '@santi020k/lumen-astro/styles/foundation.css'
import '@santi020k/lumen-astro/styles/themes/studio.css'
import '@santi020k/lumen-astro/styles/themes/paper.css'
import '@santi020k/lumen-astro/styles/themes/field.css'
import '@santi020k/lumen-astro/styles/themes/santi020k.css'
import '@santi020k/lumen-astro/styles/effects/glass.css'
import './styles/harbor.css'
import './styles/starter.css'

import { Link } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import lumenIcon from './assets/lumen-icon.svg?url'
import Dashboard from './components/Dashboard.astro'
import Landing from './components/Landing.astro'
import Portfolio from './components/Portfolio.astro'
import Storefront from './components/Storefront.astro'

interface Props {
  page?: 'landing' | 'ecommerce' | 'dashboard' | 'portfolio'
  basePath?: string
  socialImage?: string
  socialImageWidth?: number
  socialImageHeight?: number
}

const {
  page = 'landing', basePath = '', socialImage,
  socialImageWidth = 1200, socialImageHeight = 630
} = Astro.props

const route = (name: string) => name === 'landing' ? basePath || '/' : `${basePath}/${name}`

const pages = [
  { id: 'landing', label: 'Home' },
  { id: 'ecommerce', label: 'Shop' },
  { id: 'portfolio', label: 'Services' }
]

const titles = {
  landing: 'Pet care your best friend deserves',
  ecommerce: 'Pet essentials for happy companions',
  dashboard: 'A clearer view of pet care',
  portfolio: 'Thoughtful care for every companion'
}

const title = `${titles[page]} · Pet Care Plus`
const description = 'Friendly dog walking, grooming, boarding, pet sitting, puppy training, and pet essentials.'
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
const imageAlt = `${title} social preview`

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'en'
}).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="en" data-theme="lumen-light" data-starter-family="paper" data-lumen-scheme="light" data-lumen-preset="paper">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href={lumenIcon} type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="description"
      content={description}
    />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {canonical && <meta name="twitter:url" content={canonical} />}
    {canonical && <script is:inline type="application/ld+json" set:html={structuredData} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content={imageAlt} />
        <meta property="og:image:width" content={String(socialImageWidth)} />
        <meta property="og:image:height" content={String(socialImageHeight)} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
  </head>
  <body class="starter-body">
    <Link class="starter-skip" href="#main">
      Skip to content
    </Link>
    <div class="starter-toolbar">
      <div class="starter-toolbar-inner">
        <Link
          class="starter-wordmark"
          href={route('landing')}
          variant="inherit"
        >
          <img src={lumenIcon} alt="Pet Care Plus" width="28" height="28" />
          <span>Pet Care Plus</span>
        </Link>
        <nav aria-label="Main navigation" class="starter-nav">
          {pages.map(item => (
            <Link
              aria-current={page === item.id ? 'page' : undefined}
              href={route(item.id)}
              variant="inherit"
            >
              {item.label}
            </Link>
          ))}
        </nav>
      </div>
    </div>
    <main id="main" tabindex="-1" class="starter-main">
      {page === 'landing' && <Landing basePath={basePath} />}
      {page === 'ecommerce' && <Storefront />}
      {page === 'dashboard' && <Dashboard />}
      {page === 'portfolio' && <Portfolio />}
    </main>
    <footer class="starter-footer">
      <div>
        <strong>Pet Care Plus</strong>
        <p>1234 Happy Tails Lane<br />Austin, TX 78701</p>
        <p><a href="tel:+15125550148">(512) 555-0148</a></p>
      </div>
      <div class="starter-footer-links">
        <Link href={route('landing')} variant="inherit">Home</Link>
        <Link href={route('ecommerce')} variant="inherit">Shop</Link>
        <Link href={route('portfolio')} variant="inherit">Services</Link>
      </div>
    </footer>
    <UIPrimitives />
  </body>
</html>
